{
  "extends": "../../scripts/tsconfig.json",
  "compilerOptions": {
    // Archon loads the directories under .archon/workflows as packs and discovers scripts
    // under .archon/, so the build cache lives with the scripts project's, not beside this file.
    "tsBuildInfoFile": "../../scripts/.tsbuild/pack-scripts.tsbuildinfo"
  },
  "files": [
    "../../packages/script-api/src/archon-script.d.ts"
  ],
  "include": [
    "*.ts",
    "__tests__/*.ts",
    "__tests__/fixtures/*.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.test.tsx",
    "**/*.spec.tsx"
  ]
}
