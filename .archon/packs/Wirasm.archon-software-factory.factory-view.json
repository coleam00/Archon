                "icon": "link",
                "kind": "agent",
                "covers": [
                  {
                    "workflow": "triage",
                    "steps": [
                      "link__link"
                    ]
                  }
                ]
              },
              {
                "title": "Would it start on its own",
                "text": "Decides whether it would start without you; nothing acts on it",
                "icon": "ruler",
                "kind": "agent",
                "covers": [
                  {
                    "workflow": "triage",
                    "steps": [
                      "admit"
                    ]
                  }
