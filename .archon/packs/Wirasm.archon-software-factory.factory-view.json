{
  "version": 1,
  "pack": "Wirasm/archon-software-factory",
  "title": "Software factory",
  "summary": "Work comes in as a work order, or as an issue someone adds the factory label to. Order turns each one into an item the factory can read. Triage decides whether the item is worth building. Plan writes down the approach. Build writes the change and opens a draft pull request. Three checks then read it (a review, a test check and a product check) and send what they find back to the builder, for up to three rounds. Once they approve, the factory reads CI and the reviews on the pull request and fixes what they raise. A ready change goes to a merge gate that lets it through or asks you; told \"land\", the factory merges it itself. A person steps in only to answer the questions an item asks, and to shape an item triage or your answer sent back to shaping.",
  "stages": [
    {
      "id": "order",
      "label": "Order",
      "blurb": "Takes a work order, or an issue someone added the factory label to, and makes it one item the factory can read.",
      "short": "Orders, labelled issues",
      "group": "intake",
      "workflows": [
        "order"
      ],
      "drilldown": {
        "phases": [
          {
            "label": "Take the order",
            "cards": [
              {
                "title": "Take the order",
                "text": "Turns a work order, or an issue given the factory label, into one item the factory can read",
                "icon": "inbox",
                "kind": "script",
                "covers": [
                  {
                    "workflow": "order",
                    "steps": [
                      "order"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "triage",
      "label": "Triage",
      "blurb": "Reads a new item and decides whether it is worth building.",
      "short": "Is it worth building?",
      "group": "intake",
      "workflows": [
        "triage",
        "split"
      ],
      "drilldown": {
        "phases": [
