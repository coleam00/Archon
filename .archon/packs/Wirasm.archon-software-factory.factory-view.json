                "kind": "script",
                "covers": [
                  {
                    "workflow": "triage",
                    "steps": [
                      "admitted"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "label": "Split",
            "cards": [
              {
                "title": "Cut it into pieces",
                "text": "Decides how an item that is not one change is split",
                "icon": "scissors",
                "kind": "agent",
                "covers": [
                  {
                    "workflow": "split",
                    "steps": [
                      "cut"
                    ]
                  }
                ]
              },
              {
                "title": "Start the pieces",
                "text": "Orders each piece that can start now as an item of its own",
                "icon": "inbox",
                "kind": "script",
                "covers": [
                  {
                    "workflow": "split",
                    "steps": [
                      "members"
                    ]
                  }
                ]
              }
            ]
          }
