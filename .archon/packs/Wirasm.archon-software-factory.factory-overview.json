        {
          "id": "ci",
          "title": "CI and reviews",
          "text": "What CI and reviewers say on the PR",
          "icon": "eye",
          "kind": "check",
          "col": 6,
          "row": 2
        },
        {
          "id": "ready",
          "title": "Ready to merge",
          "text": "Approved; the gate lets it merge or asks you",
          "icon": "git-pull-request",
          "kind": "outcome",
          "col": 7,
          "row": 2
        },
        {
          "id": "landed",
          "title": "Merged",
          "text": "The change is in main",
          "icon": "flag",
          "kind": "outcome",
          "col": 8,
          "row": 2
        },
        {
          "id": "you",
          "title": "You",
          "text": "Answer what the factory asks",
          "icon": "users",
          "kind": "person",
          "col": 3,
          "row": 1
        },
        {
          "id": "landgate",
