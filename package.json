{
  "name": "archon",
  "version": "0.12.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "cli": "bun --cwd packages/cli src/cli.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun --filter @archon/server dev",
    "provision:docker": "bun --filter @archon/server provision:docker",
    "start": "bun --filter @archon/server start",
    "build": "bun --filter '*' build",
    "build:binaries": "bash scripts/build-binaries.sh",
    "build:runner-image": "bash scripts/build-runner-image.sh",
    "build:checksums": "bash scripts/checksums.sh",
    "generate:pi-vendor-map": "bun run scripts/generate-pi-vendor-map.ts",
    "check:pi-vendor-map": "bun run scripts/generate-pi-vendor-map.ts --check",
    "generate:codex-protocol": "bun run scripts/generate-codex-protocol.ts",
    "generate:capability-matrix": "bun run scripts/generate-capability-matrix.ts",
    "generate:node-execution-reference": "bun run packages/workflows/src/scripts/generate-node-execution-reference.ts",
    "check:node-execution-reference": "bun run packages/workflows/src/scripts/generate-node-execution-reference.ts --check",
    "check:capability-matrix": "bun run scripts/generate-capability-matrix.ts --check",
    "check:api-types": "bun run --cwd=packages/server check:api-types",
    "generate:provider-contract-schema": "bun run --cwd=packages/provider-contract generate:schema",
    "check:provider-contract-schema": "bun run --cwd=packages/provider-contract check:schema",
    "generate:sqlite-vintages": "bun run scripts/generate-sqlite-vintages.ts",
    "check:sqlite-vintages": "bun run scripts/generate-sqlite-vintages.ts --check",
    "check:schema-upgrades": "bun run scripts/check-schema-upgrades.ts",
    "lens-yield": "bun run scripts/lens-yield.ts",
    "test:install": "bash scripts/test-install.sh",
    "test": "bun run scripts/repo-tests.ts",
    "test:watch": "bun --filter @archon/server test:watch",
    "type-check": "bun --filter '*' type-check && bun x tsc --noEmit -p scripts/tsconfig.json && bun x tsc --noEmit -p .archon/scripts/tsconfig.json && bun x tsc --noEmit -p .archon/workflows/tsconfig.json",
    "lint": "bun run scripts/check-test-cleanup-drift.ts && bun run scripts/check-pack-portability.ts && bun run scripts/check-workflow-persistence.ts && bun run scripts/check-sdk-type-drift.ts && biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "dev:web": "bun --filter @archon/web dev",
    "build:web": "bun --filter @archon/web build",
    "dev:docs": "bun --filter @archon/docs-web dev",
    "build:docs": "bun --filter @archon/docs-web build",
    "validate": "bun run scripts/validate.ts",
    "prepare": "husky",
    "setup-auth": "bun --filter @archon/server setup-auth",
    "check:cli-import-boundary": "bun run scripts/check-cli-import-boundary.ts",
    "check:package-edges": "bun run scripts/check-package-edges.ts",
    "check:ratchet": "bun run scripts/check-ratchet.ts",
    "check:mock-modules": "bun run scripts/check-mock-modules.ts",
    "generate:chat-contract-schema": "bun run --cwd=packages/chat-contract generate:schema",
    "check:chat-contract-schema": "bun run --cwd=packages/chat-contract check:schema"
  },
  "devDependencies": {
    "@archon/core": "workspace:*",
    "@archon/git": "workspace:*",
    "@archon/paths": "workspace:*",
    "@archon/providers": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@types/bun": "latest",
    "bun-types": "^1.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "pino-pretty": "^13",
    "typescript": "^5.3.0"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "overrides": {
    "test-exclude": "^7.0.1",
    "axios": "^1.15.2",
    "follow-redirects": "^1.16.0",
    "path-to-regexp": "^8.4.2",
    "qs": "^6.15.2",
    "flatted": "^3.4.2",
    "@hono/node-server": "^1.19.15",
    "ws": "^8.21.0",
    "sharp": "^0.35.0"
  }
}
