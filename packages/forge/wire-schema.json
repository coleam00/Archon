                "green",
                "red",
                "gated",
                "unknown"
              ]
            }
          },
          "required": [
            "name",
            "source",
            "state"
          ],
          "additionalProperties": false
        }
      },
      "required": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "none",
              "pending",
              "green",
              "red",
              "gated",
              "unknown"
            ]
          },
          "counts": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "pending": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "green": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "red": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
