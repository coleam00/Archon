  "HostsConfig": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "propertyNames": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "additionalProperties": {
      "type": "object",
      "properties": {
        "plugin": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "token_env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
