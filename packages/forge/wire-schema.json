  "Audit": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "op": {
        "type": "string"
      },
      "target": {
        "type": "string"
      },
      "plugin": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": false
      },
      "outcome": {
        "anyOf": [
          {
            "type": "string",
            "const": "ok"
          },
          {
            "type": "string",
            "const": "process_failure"
          },
          {
            "type": "string",
            "enum": [
              "unsupported_op",
              "no_plugin_for_host",
              "no_credential",
              "not_found",
              "verify_failed",
              "forge_error",
              "invalid_request",
              "invalid_response"
            ]
          }
        ]
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "op",
      "target",
      "outcome",
      "duration_ms"
    ],
    "additionalProperties": false
  }
