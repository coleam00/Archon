          "pending": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "green": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "red": {
            "type": "integer",
            "minimum": 0,
