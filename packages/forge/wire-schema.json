          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "target"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "verify_failed"
          },
          "expected": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "leave_behind": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "expected",
          "observed"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "forge_error"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "evidence"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
