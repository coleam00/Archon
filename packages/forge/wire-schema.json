      "path": {
        "type": "string",
        "pattern": "^[\\p{L}\\p{N}_.-]+(?:\\/[\\p{L}\\p{N}_.-]+)+$"
      }
    },
    "required": [
      "host",
      "path"
    ],
    "additionalProperties": false
  },
