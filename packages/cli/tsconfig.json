{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Doctor shares the SDLC pack's preflight, and pack modules import
    // each other with `.ts` extensions (pack scripts run under Bun with no build step).
    "allowImportingTsExtensions": true,
    "paths": {
      "@archon/adapters": ["../adapters/src"],
      "@archon/adapters/*": ["../adapters/src/*"],
      "@archon/core": ["../core/src"],
      "@archon/core/*": ["../core/src/*"],
      "@archon/server": ["../server/src"],
      "@archon/server/*": ["../server/src/*"],
      "@archon/workflows": ["../workflows/src"],
      "@archon/workflows/*": ["../workflows/src/*"],
      "@archon/paths": ["../paths/src"],
      "@archon/git": ["../git/src"]
    }
  },
  "include": [
    "src/**/*",
    "../core/src/**/*.ts",
    "../server/src/**/*.ts",
    "../adapters/src/**/*.ts",
    "../workflows/src/defaults/text-imports.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
