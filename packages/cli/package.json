{
  "name": "@archon/cli",
  "version": "0.10.1",
  "type": "module",
  "main": "./src/cli.ts",
  "bin": {
    "archon": "./src/cli.ts"
  },
  "scripts": {
    "cli": "bun src/cli.ts",
