    "@archon/providers": "workspace:*",
    "@archon/server": "workspace:*",
    "@archon/workflows": "workspace:*",
    "@clack/prompts": "^1.0.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "testGroups": [
